# Copy this file to .env and fill in your own key before running docker compose.
#   cp .env.example .env

OPENAI_API_KEY=sk-your-key-here

# Qdrant Cloud cluster (Cluster URL + API key from your Qdrant Cloud dashboard).
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# "log" (default) needs no Google credentials - candidate actions are written to
# n8n_data/*.json only. Set to "live" only after configuring Gmail + Google Calendar
# OAuth credentials inside n8n (see README.md).
ACTION_MODE=log

# Host ports the three services are published on. Change these if something else on your
# machine already uses them; the container-internal ports stay the same either way.
UI_PORT=8502
AGENT_PORT=5001
N8N_PORT=5679
